{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://arrivealive.tail04a318.ts.net"
      }
    },
    "testing": {
      "distribution": "internal",
      "channel": "testing",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "testing",
        "EXPO_PUBLIC_BACKEND_URL": "https://arrivealive.tail04a318.ts.net:8443"
      }
    },
    "preview-public": {
      "distribution": "internal",
      "channel": "preview-public",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://preview-fopohpplspve.dev.vibecode.run"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://arrivealive.tail04a318.ts.net"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
