generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// Better Auth Models
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// Arrive Alive Tour Kiosk Models
// ==========================================

model Team {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // Unique short code for the team (tablets)
  phoneCode String?  @unique // Separate code for phone devices
  // Only teams marked as admin teams can open the Admin section in the app.
  // Off by default: a field team's tablet joins with a team code and must not
  // be able to reach events, devices, results or the data wipe. Designated in
  // the admin portal's Teams tab.
  isAdminTeam Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  devices         Device[]
  events          Event[]
  surveyResponses SurveyResponse[]
  pledges         Pledge[]
  photos          Photo[]
  syncLogs        SyncLog[]
  localPhotos     LocalPhoto[]

  @@index([code])
  @@index([phoneCode])
}

model Device {
  id         String   @id @default(cuid())
  teamId     String
  deviceType String   // "tablet" | "phone"
  deviceName String
  lastSyncAt DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  surveyResponses SurveyResponse[]
  syncLogs        SyncLog[]
  photoReceipts   PhotoReceipt[]

  @@index([teamId])
  @@index([deviceType])
}

model Event {
  id                   String   @id @default(cuid())
  teamId               String
  venueName            String
  venueCity            String
  venueState           String
  eventDate            DateTime
  // Scheduled end of the event — the plan, not a shutdown. Events run late, so
  // passing this time neither closes the event nor deletes anything: the purge
  // (src/lib/event-purge.ts) waits for someone to END the event (facilitator on
  // a device, or "Complete" in the admin portal), which stamps completedAt.
  // The one exception is an event left open RUN_LONG_GRACE_MS past this time —
  // that one was forgotten, and is closed and purged automatically.
  eventEndAt           DateTime?
  // IANA time zone the event is actually run in ("America/Chicago"), captured
  // from the admin portal when the event is saved. Timestamps are stored as
  // instants (UTC), so a tablet whose clock is set to another zone used to show
  // a 9pm end time as 2am. Every screen formats against this instead of the
  // device zone, so the venue always sees the time the office typed.
  timeZone             String?
  // Set by the purge once it has finished for this event. Also stops the purge
  // from re-running against the same event every tick.
  photosPurgedAt       DateTime?
  surveyTypes          String   // JSON string array of survey type slugs enabled for this event
  overlayType          String   // Legacy: photo overlay type slug for this event
  overlayId            String?  // Custom uploaded overlay assigned to this event
  picturePledgeEnabled Boolean  @default(false) // Whether picture pledge feature is enabled
  status               String   @default("active") // "active" | "completed"
  // When the event was actually ended by a person. This — not eventEndAt — is
  // the moment the auto-purge measures its wait from.
  completedAt          DateTime?
  createdAt            DateTime @default(now())

  // Relations
  team                  Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  overlay               Overlay?               @relation(fields: [overlayId], references: [id], onDelete: SetNull)
  surveyResponses       SurveyResponse[]
  pledges               Pledge[]
  photos                Photo[]
  localPhotos           LocalPhoto[]
  externalSurveyImports ExternalSurveyImport[]

  @@index([teamId])
  @@index([eventDate])
  @@index([eventEndAt])
  @@index([status])
}

model SurveyType {
  id          String   @id @default(cuid())
  slug        String   @unique // "marijuana", "alcohol", "distracted", "impaired", "combo"
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  questions SurveyQuestion[]

  @@index([slug])
  @@index([isActive])
}

model SurveyQuestion {
  id           String   @id @default(cuid())
  surveyTypeId String
  orderIndex   Int      // 1-based position within the survey
  questionText String
  // "single_choice" — pick exactly one option, kiosk auto-advances.
  // "multi_select" — multiple choice: pick any number of options, kiosk shows
  //                  a Continue button. The answer is stored as a JSON array.
  answerType   String   @default("single_choice")
  options      String   // JSON array of answer options
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  surveyType SurveyType @relation(fields: [surveyTypeId], references: [id], onDelete: Cascade)

  @@unique([surveyTypeId, orderIndex])
  @@index([surveyTypeId])
}

// Anonymous survey submission.
//
// PRIVACY RULE: this model must never carry anything that identifies the
// participant, and nothing may point at it from a model that does. There is
// deliberately NO relation to Pledge — a pledge holds an email address, so a
// pledge -> survey foreign key would turn every survey answer into identified
// data. Do not add one back. `deviceId` identifies the tablet, not a person,
// and is only kept so a mis-syncing device can be found.
model SurveyResponse {
  id              String    @id @default(cuid())
  localId         String    @unique // Unique ID from device for deduplication
  teamId          String
  eventId         String
  surveyTypeSlug  String    // e.g., "marijuana", "alcohol"
  responses       String    // JSON object of question answers
  ageRange        String?   // "13-17", "18-24", "25-34", "35+"
  deviceId        String?
  completedAt     DateTime  @default(now())
  syncedAt        DateTime?
  durationSeconds Int?      // Time taken to complete survey

  // Relations (no Pledge relation on purpose — see the note above)
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  device  Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([localId])
  @@index([teamId])
  @@index([eventId])
  @@index([surveyTypeSlug])
  @@index([completedAt])
}

// A participant's picture pledge.
//
// This is the ONLY model that holds a participant email address, and it holds
// it for as long as it takes to send them their photo — no longer. Once the
// email is delivered, `email` is blanked and `emailPurgedAt` is stamped by
// scrubPledgeAfterSend() in src/lib/pledge-privacy.ts. The empty row is kept so
// the pledge still counts in reporting.
//
// There is intentionally NO link to SurveyResponse. See the note on that model.
model Pledge {
  id               String    @id @default(cuid())
  localId          String    @unique // Unique ID from device for deduplication
  teamId           String
  eventId          String
  email            String    // Blanked to "" once the photo email has been sent
  emailPurgedAt    DateTime? // When the address was erased from this row
  photoId          String?   // Optional link to photo
  emailStatus      String    @default("pending") // "pending" | "queued" | "sent" | "failed" | "skipped"
  emailSentAt      DateTime?
  emailError       String?
  createdAt        DateTime  @default(now())
  syncedAt         DateTime?

  // Relations
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo          Photo?          @relation(fields: [photoId], references: [id], onDelete: SetNull)
  emailQueue     EmailQueue[]

  @@index([localId])
  @@index([teamId])
  @@index([eventId])
  @@index([email])
  @@index([emailStatus])
}

model Photo {
  id          String    @id @default(cuid())
  localId     String    @unique // Unique ID from device for deduplication
  teamId      String
  eventId     String
  storageKey  String?   // Key in storage system (e.g., S3 key)
  storageUrl  String?   // Full URL to access the ORIGINAL (raw, no-overlay) photo
  overlayType String    // Type of overlay applied
  // Photo status state machine (single source of truth):
  // "available"  — uploaded/synced from phone, selectable by participants
  // "selected"   — a participant has picked it (locked so no one else can)
  // "processing" — overlay is being applied / finished photo is being sent
  // "sent"       — finished (overlaid) photo successfully delivered
  // "deleted"    — cleaned up; should be removed from phone + both tablets
  status             String    @default("available")
  selectedByDeviceId String?   // Device (tablet) that selected/locked this photo
  finishedPhotoUrl   String?   // The composited/overlaid finished result
  usedAt             DateTime? // Retained for backwards compat (set when sent)
  sentAt             DateTime? // When the finished photo was successfully delivered
  deletedAt          DateTime? // When the photo was marked deleted
  // Phone-side original cleanup: set once the CAPTURING PHONE has confirmed it
  // removed its local copy of the original. Does NOT affect `status` (the photo
  // stays "available" for the tablets). Prevents re-returning it in the
  // phone-cleanup list.
  captureDeviceId      String?  // Phone device that captured this photo
  phoneOriginalDeleted Boolean  @default(false)
  createdAt          DateTime  @default(now())
  syncedAt           DateTime?

  // Relations
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pledges  Pledge[]
  receipts PhotoReceipt[]

  @@index([localId])
  @@index([teamId])
  @@index([eventId])
  @@index([status])
  @@index([captureDeviceId])
}

// Per-photo, per-tablet receipt. One row = one tablet device confirmed it has
// cached the photo's file locally. Used to decide when it is safe to tell the
// capturing phone to delete its local original (only after ALL active tablets
// have a receipt).
model PhotoReceipt {
  id         String   @id @default(cuid())
  photoId    String
  deviceId   String   // Tablet device that received the photo
  receivedAt DateTime @default(now())

  // Relations
  photo  Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([photoId, deviceId]) // Idempotent acknowledgement
  @@index([photoId])
  @@index([deviceId])
}

// Outbound pledge email waiting to be sent.
//
// PRIVACY: `toEmail` is a participant address, so a queue row is DELETED the
// moment the send succeeds (see EmailQueueProcessor.processEmail). Rows only
// linger while an email is pending or has permanently failed.
model EmailQueue {
  id          String    @id @default(cuid())
  pledgeId    String
  toEmail     String
  subject     String
  htmlBody    String
  photoUrl    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  status      String    @default("pending") // "pending" | "processing" | "sent" | "failed"
  lastError   String?
  scheduledAt DateTime  @default(now())
  processedAt DateTime?

  // Relations
  pledge Pledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@index([status])
  @@index([scheduledAt])
}

model SyncLog {
  id          String   @id @default(cuid())
  deviceId    String?
  teamId      String
  syncType    String   // Type of sync operation
  itemCount   Int      @default(0)
  status      String   // "success" | "partial" | "failed"
  errorDetail String?
  syncedAt    DateTime @default(now())

  // Relations
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([teamId])
  @@index([syncedAt])
}

// ==========================================
// Overlay Model (Custom Photo Overlays)
// ==========================================

model Overlay {
  id          String   @id @default(cuid())
  name        String
  fileId      String   // For deletion from storage
  url         String   // CDN URL
  filename    String
  contentType String
  sizeBytes   Int
  isActive    Boolean  @default(true)

  // How the overlay is applied to a pledge photo:
  //   "auto"    -> transparent images are laid on top, opaque ones (JPG) are
  //                treated as a polaroid-style frame
  //   "overlay" -> always stretched on top of the photo (needs transparency)
  //   "frame"   -> photo is placed inside the window rect below (polaroid)
  mode String @default("auto")

  // Window rect for frame mode, as fractions (0-1) of the frame image.
  // Detected automatically on upload; admins can fine-tune it.
  windowX Float?
  windowY Float?
  windowW Float?
  windowH Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events Event[]

  @@index([isActive])
}

// ==========================================
// Local Photo Transfer Model (Offline Environments)
// ==========================================

model LocalPhoto {
  id              String    @id @default(cuid())
  localId         String    @unique // Unique ID from phone device for deduplication
  teamId          String
  eventId         String
  overlayType     String    // Type of overlay applied
  deviceId        String    // Phone device ID that captured the photo
  tabletDeviceId  String?   // Tablet device ID that received the photo (if synced)
  syncedToTablet  Boolean   @default(false)
  syncedAt        DateTime? // When photo was synced to tablet
  createdAt       DateTime  @default(now())

  // Relations
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([localId])
  @@index([teamId])
  @@index([eventId])
  @@index([deviceId])
  @@index([tabletDeviceId])
  @@index([syncedToTablet])
}

// ==========================================
// External Survey Imports (Google Forms/Sheets)
// ==========================================

model ExternalSurveyImport {
  id          String   @id @default(cuid())
  eventId     String
  surveyPhase String   // "pre" | "post"
  fileName    String   // Original file/sheet name
  rowCount    Int      @default(0)
  headers     String   // JSON array of column headers
  importedAt  DateTime @default(now())

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows  ExternalSurveyRow[]

  @@index([eventId])
  @@index([surveyPhase])
  @@index([importedAt])
}

model ExternalSurveyRow {
  id       String @id @default(cuid())
  importId String
  rowIndex Int
  data     String // JSON object of column -> value

  // Relations
  import ExternalSurveyImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
}

// ==========================================
// Admin Users (for Web Portal Authentication)
// ==========================================

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   // Hashed password
  displayName  String?
  role         String   @default("admin") // "admin" | "superadmin"
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
  @@index([isActive])
}
